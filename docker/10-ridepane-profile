#!/bin/bash
set -euo pipefail

old_profile=/config/.config/chromium
new_profile=/config/ridepane-chromium

if [ ! -d "$new_profile" ]; then
  if [ -f "$old_profile/Local State" ]; then
    staging=$(mktemp -d /config/.ridepane-chromium-XXXXXX)
    cp -a "$old_profile"/. "$staging"/
    chown abc:users "$staging"
    mv "$staging" "$new_profile"
  else
    mkdir -p "$new_profile"
    chown abc:users "$new_profile"
  fi
fi

# The browser has stopped when custom init runs. Its lock links point into the
# old container's /tmp and can block Chromium after an image update or restart.
rm -f "$new_profile/SingletonCookie" "$new_profile/SingletonLock" "$new_profile/SingletonSocket"

# The base image waits for this PID path before starting Selkies. PulseAudio
# now keeps its socket and PID in a private, writable runtime directory.
if [ "${PULSE_RUNTIME_PATH:-/defaults}" != /defaults ]; then
  ln -sfn "$PULSE_RUNTIME_PATH/pid" /defaults/pid
fi
